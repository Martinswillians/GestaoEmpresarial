rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function admin() {
      return logado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin do portal: o documento admins/{seuUID} é criado manualmente no console
    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
    }

    // Mural da tela inicial: todos leem, só o admin publica
    match /announcements/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Cada empresa só acessa os próprios dados
    match /companies/{cid} {
      allow read: if logado() && (request.auth.uid == cid || admin());
      allow create, update: if logado() && request.auth.uid == cid;

      match /{sub}/{doc} {
        allow read, write: if logado() && request.auth.uid == cid;
      }
    }
  }
}
