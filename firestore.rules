rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function admin() {
      return logado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function dono(cid) { return logado() && request.auth.uid == cid; }

    // Usuário administrativo: convite criado pela empresa (documento = e-mail em minúsculas)
    function emailConv() { return request.auth.token.email.lower(); }
    function convOk() {
      return logado() && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/invites/$(emailConv()));
    }
    function conv() {
      return get(/databases/$(database)/documents/invites/$(emailConv())).data;
    }
    function equipe(cid) { return convOk() && conv().company == cid; }
    function perm(cid, k) { return equipe(cid) && conv().perms.get(k, false) == true; }

    // Solicitação feita por cliente na página pública de agendamento
    function reqOk(cid) {
      let d = request.resource.data;
      return exists(/databases/$(database)/documents/public/$(cid)) &&
        get(/databases/$(database)/documents/public/$(cid)).data.enabled == true &&
        d.keys().hasOnly(['name','phone','email','addr','svc','svcName','date','time','obs','status','createdAt','uid']) &&
        (!d.keys().hasAny(['uid']) || (logado() && d.uid == request.auth.uid)) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        d.phone is string && d.phone.size() <= 20 &&
        d.email is string && d.email.size() <= 80 &&
        d.addr is string && d.addr.size() <= 140 &&
        d.obs is string && d.obs.size() <= 300 &&
        d.svc is string && d.svcName is string && d.svcName.size() <= 100 &&
        d.date is string && d.date.size() == 10 &&
        d.time is string && d.time.size() == 5 &&
        d.status == 'new' && d.createdAt == request.time;
    }

    // Contas de clientes (login na página de agendamento) e o acompanhamento das solicitações
    match /customers/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email','name','phone','addr','cos','photo','createdAt']) &&
        (!request.resource.data.keys().hasAny(['photo']) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 70000)) &&
        (!request.resource.data.keys().hasAny(['addr']) || (request.resource.data.addr is string && request.resource.data.addr.size() <= 140)) &&
        (!request.resource.data.keys().hasAny(['cos']) || (request.resource.data.cos is list && request.resource.data.cos.size() <= 20)) &&
        request.resource.data.email is string && request.resource.data.email.size() <= 80 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
      match /requests/{rid} {
        allow read: if logado() && request.auth.uid == uid;
        allow create: if logado() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['company','companyName','svcName','date','time','addr','obs','status','createdAt']) &&
          request.resource.data.status == 'new' &&
          request.resource.data.createdAt == request.time;
        // a empresa (ou a equipe com permissão de agenda) só atualiza o status
        allow update: if (dono(resource.data.company) || perm(resource.data.company, 'agenda')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }
      // Serviços agendados, espelhados pela empresa para o cliente acompanhar
      match /appts/{aid} {
        allow read: if logado() && request.auth.uid == uid;
        allow create, update: if (dono(request.resource.data.company) || perm(request.resource.data.company, 'agenda')) &&
          request.resource.data.keys().hasOnly(['company','companyName','svcName','date','time','dur','status','team','addr','extras']);
        allow delete: if dono(resource.data.company) || perm(resource.data.company, 'agenda');
      }
    }

    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Dados públicos da empresa para a página de agendamento
    match /public/{cid} {
      allow read: if true;
      allow write: if dono(cid);
    }

    match /invites/{em} {
      allow get: if logado() && request.auth.token.email != null && request.auth.token.email.lower() == em;
      allow list: if logado() && resource.data.company == request.auth.uid;
      allow create: if dono(request.resource.data.company);
      allow update: if dono(resource.data.company) && dono(request.resource.data.company);
      allow delete: if dono(resource.data.company);
    }

    // Network entre empresas (liberadas pelo admin do portal)
    function netOk() {
      return logado() &&
        exists(/databases/$(database)/documents/network_members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/network_members/$(request.auth.uid)).data.enabled == true;
    }
    match /network_members/{cid} {
      allow read: if dono(cid) || admin();
      allow write: if admin();
    }
    function postFields(d) {
      return d.pub is bool &&
        d.type in ['duvida','procuro','indico','permuta'] &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 100 &&
        d.text is string && d.text.size() > 0 && d.text.size() <= 1000 &&
        d.contact is string && d.contact.size() <= 40 &&
        d.companyName is string && d.companyName.size() <= 100;
    }
    match /network_posts/{pid} {
      allow read: if netOk() || admin() || resource.data.pub == true;
      allow create: if netOk() &&
        request.resource.data.keys().hasOnly(['company','companyName','type','title','text','contact','pub','createdAt']) &&
        request.resource.data.company == request.auth.uid &&
        postFields(request.resource.data) &&
        request.resource.data.createdAt == request.time;
      // só quem criou edita, conclui ou reabre
      allow update: if netOk() && resource.data.company == request.auth.uid &&
        request.resource.data.keys().hasOnly(['company','companyName','type','title','text','contact','pub','createdAt','done','doneAt','editedAt']) &&
        request.resource.data.company == resource.data.company &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!request.resource.data.keys().hasAny(['done']) || request.resource.data.done is bool) &&
        postFields(request.resource.data);
      allow delete: if (logado() && resource.data.company == request.auth.uid) || admin();
    }
    // Conversas privadas: só quem publicou e quem respondeu (cada resposta é uma conversa de duas empresas)
    match /network_msgs/{mid} {
      allow read: if admin() || (netOk() && (resource.data.thread == request.auth.uid || resource.data.postCompany == request.auth.uid));
      allow create: if netOk() &&
        request.resource.data.keys().hasOnly(['post','postCompany','thread','company','companyName','text','createdAt']) &&
        request.resource.data.company == request.auth.uid &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600 &&
        request.resource.data.companyName is string && request.resource.data.companyName.size() <= 100 &&
        request.resource.data.createdAt == request.time &&
        get(/databases/$(database)/documents/network_posts/$(request.resource.data.post)).data.company == request.resource.data.postCompany &&
        get(/databases/$(database)/documents/network_posts/$(request.resource.data.post)).data.get('done', false) == false &&
        (request.resource.data.company == request.resource.data.postCompany || request.resource.data.thread == request.auth.uid);
      allow update: if netOk() && resource.data.company == request.auth.uid &&
        request.resource.data.keys().hasOnly(['post','postCompany','thread','company','companyName','text','createdAt','editedAt']) &&
        request.resource.data.post == resource.data.post &&
        request.resource.data.postCompany == resource.data.postCompany &&
        request.resource.data.thread == resource.data.thread &&
        request.resource.data.company == resource.data.company &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600;
      allow delete: if admin() || (logado() && (resource.data.company == request.auth.uid || resource.data.postCompany == request.auth.uid));
    }

    match /companies/{cid} {
      allow read: if dono(cid) || admin() || equipe(cid);
      allow create, update: if dono(cid);

      // Admin do portal: leitura apenas para contar registros na tela de uso
      match /{sub}/{d} {
        allow read: if admin() && sub in ['employees','clients','services','appts','requests','teams'];
      }
      // histórico de log: só a empresa e o administrador leem; ninguém altera nem apaga
      match /logs/{lid} {
        allow read: if dono(cid) || admin();
        allow create: if (dono(cid) || equipe(cid) || admin()) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.ts == request.time &&
          request.resource.data.keys().hasOnly(['ts','uid','who','role','act','ent','label','info']);
        allow update, delete: if false;
      }
      // agenda do funcionário (cópia sem valores), uma pasta por funcionário
      match /myagenda/{eid}/items/{d} {
        allow read: if dono(cid) || perm(cid, 'agenda') || (equipe(cid) && conv().get('emp', '') == eid);
        allow write: if dono(cid) || perm(cid, 'agenda');
        allow update: if equipe(cid) && conv().get('emp', '') == eid && conv().perms.get('addon', false) == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extras']);
      }
      match /appts/{d} {
        allow read: if dono(cid) || perm(cid, 'agenda') || perm(cid, 'addon');
        allow write: if dono(cid) || perm(cid, 'agenda');
        // adicionais de serviço: quem tem a permissão (e o funcionário escalado) altera só o campo extras
        allow update: if perm(cid, 'addon') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extras']) &&
          (conv().get('emp', '') == '' || conv().get('emp', '') in resource.data.get('emps', []));
      }
      // Pedidos de vínculo: o cliente logado avisa a empresa; a empresa vincula ao cadastro
      match /links/{luid} {
        allow create, update: if logado() && request.auth.uid == luid &&
          request.resource.data.keys().hasOnly(['email','name','phone','ev','at','photo']) &&
          request.resource.data.email is string && request.resource.data.email.size() <= 80 &&
          request.resource.data.email.lower() == request.auth.token.email.lower() &&
          request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
          request.resource.data.phone is string && request.resource.data.phone.size() <= 20 &&
          request.resource.data.ev == request.auth.token.email_verified &&
          (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 150000));
        allow read, delete: if dono(cid) || perm(cid, 'clients') || perm(cid, 'agenda');
      }
      match /requests/{d} {
        allow read, update, delete: if dono(cid) || perm(cid, 'agenda');
        allow create: if dono(cid) || perm(cid, 'agenda') || reqOk(cid);
      }
      match /clients/{d} {
        allow read: if dono(cid) || perm(cid, 'clients') || perm(cid, 'agenda') || perm(cid, 'cview') || perm(cid, 'cedit') || perm(cid, 'addon');
        allow create: if dono(cid) || perm(cid, 'clients') || perm(cid, 'agenda');
        allow update: if dono(cid) || perm(cid, 'clients') || perm(cid, 'cedit');
        allow delete: if dono(cid) || perm(cid, 'clients');
      }
      match /employees/{d} {
        allow read: if dono(cid) || perm(cid, 'employees') || perm(cid, 'agenda');
        allow write: if dono(cid) || perm(cid, 'employees');
      }
      match /teams/{d} {
        allow read: if dono(cid) || perm(cid, 'employees') || perm(cid, 'agenda');
        allow write: if dono(cid) || perm(cid, 'employees');
      }
      match /services/{d} {
        allow read: if dono(cid) || perm(cid, 'services') || perm(cid, 'agenda') || perm(cid, 'addon');
        allow write: if dono(cid) || perm(cid, 'services');
      }
      match /tx/{d} {
        allow read, write: if dono(cid) || perm(cid, 'fin');
      }
    }
  }
}
