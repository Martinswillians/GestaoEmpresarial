rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function admin() {
      return logado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function dono(cid) { return logado() && request.auth.uid == cid; }

    // Usuário administrativo: convite criado pela empresa (documento = e-mail em minúsculas)
    function emailConv() { return request.auth.token.email.lower(); }
    function convOk() {
      return logado() && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/invites/$(emailConv()));
    }
    function conv() {
      return get(/databases/$(database)/documents/invites/$(emailConv())).data;
    }
    function equipe(cid) { return convOk() && conv().company == cid; }
    function perm(cid, k) { return equipe(cid) && conv().perms.get(k, false) == true; }

    // Solicitação feita por cliente na página pública de agendamento
    function reqOk(cid) {
      let d = request.resource.data;
      return exists(/databases/$(database)/documents/public/$(cid)) &&
        get(/databases/$(database)/documents/public/$(cid)).data.enabled == true &&
        d.keys().hasOnly(['name','phone','email','addr','svc','svcName','date','time','obs','status','createdAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        d.phone is string && d.phone.size() <= 20 &&
        d.email is string && d.email.size() <= 80 &&
        d.addr is string && d.addr.size() <= 140 &&
        d.obs is string && d.obs.size() <= 300 &&
        d.svc is string && d.svcName is string && d.svcName.size() <= 100 &&
        d.date is string && d.date.size() == 10 &&
        d.time is string && d.time.size() == 5 &&
        d.status == 'new' && d.createdAt == request.time;
    }

    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Dados públicos da empresa para a página de agendamento
    match /public/{cid} {
      allow read: if true;
      allow write: if dono(cid);
    }

    match /invites/{em} {
      allow get: if logado() && request.auth.token.email != null && request.auth.token.email.lower() == em;
      allow list: if logado() && resource.data.company == request.auth.uid;
      allow create: if dono(request.resource.data.company);
      allow update: if dono(resource.data.company) && dono(request.resource.data.company);
      allow delete: if dono(resource.data.company);
    }

    // Network entre empresas (liberadas pelo admin do portal)
    function netOk() {
      return logado() &&
        exists(/databases/$(database)/documents/network_members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/network_members/$(request.auth.uid)).data.enabled == true;
    }
    match /network_members/{cid} {
      allow read: if dono(cid) || admin();
      allow write: if admin();
    }
    match /network_posts/{pid} {
      allow read: if netOk() || admin();
      allow create: if netOk() &&
        request.resource.data.keys().hasOnly(['company','companyName','type','title','text','contact','createdAt']) &&
        request.resource.data.company == request.auth.uid &&
        request.resource.data.type in ['duvida','procuro','indico','permuta'] &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
        request.resource.data.contact is string && request.resource.data.contact.size() <= 40 &&
        request.resource.data.companyName is string && request.resource.data.companyName.size() <= 100 &&
        request.resource.data.createdAt == request.time;
      allow delete: if (logado() && resource.data.company == request.auth.uid) || admin();
      match /replies/{rid} {
        allow read: if netOk() || admin();
        allow create: if netOk() &&
          request.resource.data.keys().hasOnly(['company','companyName','text','createdAt']) &&
          request.resource.data.company == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600 &&
          request.resource.data.createdAt == request.time;
        allow delete: if (logado() && resource.data.company == request.auth.uid) || admin();
      }
    }

    match /companies/{cid} {
      allow read: if dono(cid) || admin() || equipe(cid);
      allow create, update: if dono(cid);

      match /appts/{d} {
        allow read, write: if dono(cid) || perm(cid, 'agenda');
      }
      match /requests/{d} {
        allow read, update, delete: if dono(cid) || perm(cid, 'agenda');
        allow create: if dono(cid) || perm(cid, 'agenda') || reqOk(cid);
      }
      match /clients/{d} {
        allow read: if dono(cid) || perm(cid, 'clients') || perm(cid, 'agenda');
        allow create: if dono(cid) || perm(cid, 'clients') || perm(cid, 'agenda');
        allow update, delete: if dono(cid) || perm(cid, 'clients');
      }
      match /employees/{d} {
        allow read: if dono(cid) || perm(cid, 'employees') || perm(cid, 'agenda');
        allow write: if dono(cid) || perm(cid, 'employees');
      }
      match /teams/{d} {
        allow read: if dono(cid) || perm(cid, 'employees') || perm(cid, 'agenda');
        allow write: if dono(cid) || perm(cid, 'employees');
      }
      match /services/{d} {
        allow read: if dono(cid) || perm(cid, 'services') || perm(cid, 'agenda');
        allow write: if dono(cid) || perm(cid, 'services');
      }
      match /tx/{d} {
        allow read, write: if dono(cid) || perm(cid, 'fin');
      }
    }
  }
}
